# Runtime data (indexed DB + content blobs) — regenerated by the indexer
data/
*.db
*.db-shm
*.db-wal

# Python build / cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.hypothesis/

# Raw commit/reveal hex stashed by `inscribe --slipstream` before broadcast.
# Contains no key material, but it is the only copy of a reveal that cannot be
# re-composed — keep it locally until the mint confirms, never publish it.
reveal-*.hex

# Local env / editor
.env
.venv/
venv/
.DS_Store
.claude/
